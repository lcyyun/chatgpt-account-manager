<UserControl x:Class="GptPlusManager.Wpf.Views.AddAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GptPlusManager.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AddAccountViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <Grid MaxWidth="880" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左：手动添加 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="添加单个账号" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="填写后点「保存并添加」，账号会立即写入本地数据。" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="邮箱 *" Grid.Row="0" Margin="0,11,12,0" Style="{StaticResource SectionLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="新账号邮箱"/>
                    <TextBlock Text="密码" Grid.Row="1" Margin="0,23,12,0" Style="{StaticResource SectionLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="2FA 密钥" Grid.Row="2" Margin="0,23,12,0" Style="{StaticResource SectionLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding TwoFactorSecret, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="购买时间" Grid.Row="3" Margin="0,23,12,0" Style="{StaticResource SectionLabel}"/>
                    <DatePicker Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource ModernDatePicker}"
                                SelectedDate="{Binding PurchasedAt}" SelectedDateFormat="Short" Language="zh-CN"/>
                    <TextBlock Text="备注" Grid.Row="4" Margin="0,23,12,0" Style="{StaticResource SectionLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="保存并添加" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Padding="16,8"/>
                    <Button Content="清空表单" Style="{StaticResource ModernButton}" Command="{Binding ClearFormCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 右：批量导入 -->
            <Border Grid.Column="1" Margin="28,34,0,0" Width="360"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="批量导入" FontWeight="SemiBold"/>
                    <TextBlock Text="粘贴 JSON 备份，或每行「邮箱 | 密码 | 密钥」；也可从文件选择。已存在的邮箱会更新对应字段，不会清空已有密码或密钥。"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBox Height="150" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" Style="{StaticResource ModernTextBox}"
                             Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="导入内容"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="从文件选择…" Style="{StaticResource ModernButton}" Command="{Binding PickFileCommand}" Padding="11,6"/>
                        <Button Content="开始导入" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Padding="14,6" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource FlatFieldButton}" Command="{Binding OpenExportsFolderCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="打开导出目录">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="{StaticResource IconFolder}" Fill="{DynamicResource MutedBrush}"/></Viewbox>
                            <TextBlock Text="{Binding ExportsDirectory}" Style="{StaticResource MutedText}" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

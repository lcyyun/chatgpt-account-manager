<Window x:Class="GptPlusManager.Wpf.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出与备份" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Padding="24" Background="{DynamicResource CanvasBrush}">
        <StackPanel>
            <TextBlock Text="导出与备份" FontSize="17" FontWeight="SemiBold"/>

            <TextBlock Text="导出目录" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                <TextBlock x:Name="DirectoryText" FontFamily="Consolas" TextWrapping="Wrap"/>
            </Border>
            <Button Content="打开导出目录" Style="{StaticResource ModernButton}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Click="OpenFolder_Click"/>

            <TextBlock Text="选择要生成的导出文件" Style="{StaticResource SectionLabel}" Margin="0,22,0,0"/>
            <CheckBox x:Name="JsonBackupCheck" Content="JSON 备份（完整字段，可用于导入还原）" IsChecked="True"
                      Margin="0,10,0,0" Foreground="{DynamicResource TextBrush}"/>
            <CheckBox x:Name="TextExportCheck" Content="文本清单（每行「邮箱 | 密码 | 2FA 密钥」）" IsChecked="True"
                      Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>

            <Button Content="开始导出" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                    Margin="0,18,0,0" Click="Export_Click"/>

            <TextBlock x:Name="ExportStatus" Foreground="{DynamicResource GreenBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="关闭" Width="88" Style="{StaticResource ModernButton}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="GptPlusManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:GptPlusManager.Wpf.Infrastructure"
        xmlns:vm="clr-namespace:GptPlusManager.Wpf.ViewModels"
        xmlns:views="clr-namespace:GptPlusManager.Wpf.Views"
        mc:Ignorable="d"
        Title="ChatGPT Account Manager" Width="1320" Height="820" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 顶部页面切换按钮 -->
        <Style x:Key="PageTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="11,7"/>
        </Style>
        <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="58"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <DataTemplate x:Key="AccountCardTemplate" DataType="{x:Type vm:AccountViewModel}">
            <Grid Margin="8" infra:EntranceAnimation.IsEnabled="True">
                <Border x:Name="CardRoot" Style="{StaticResource CardBorder}">
                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="DragHandle" Grid.Column="0" Width="32" Height="32" Margin="-7,-4,4,0"
                                    Style="{StaticResource IconButton}" ToolTip="按住拖动调整顺序"
                                    AutomationProperties.Name="拖动排序把手" AutomationProperties.AutomationId="DragHandle"
                                    PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                    PreviewMouseMove="DragHandle_MouseMove" PreviewMouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                                <Path Data="{StaticResource IconDrag}" Fill="{DynamicResource MutedBrush}" Stretch="Uniform" Width="17" Height="17"/>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding CopyEmailCommand}" Style="{StaticResource FlatFieldButton}"
                                    ToolTip="单击复制完整邮箱" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Email}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Chip}" Visibility="{Binding IsCurrentCodex, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="CODEX" Foreground="{DynamicResource CyanBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding AuthorizationText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="密码" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding CopyPasswordCommand}" Style="{StaticResource FlatFieldButton}" ToolTip="单击复制密码">
                                <Grid>
                                    <TextBlock Text="{Binding PasswordMask}" FontFamily="Consolas" Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                    <TextBlock Text="{Binding Password}" FontFamily="Consolas" Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Button>
                            <CheckBox Grid.Column="2" Content="显示" IsChecked="{Binding IsPasswordVisible}" Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="2FA" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding CopySecretCommand}" Style="{StaticResource FlatFieldButton}" ToolTip="单击复制 2FA 密钥">
                                <TextBlock Text="{Binding TwoFactorSecret}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Command="{Binding CopyCodeCommand}" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" Padding="12,10" Cursor="Hand" ToolTip="单击复制当前验证码">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CodeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{Binding TotpCode}" FontFamily="Consolas" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CodeBorder" Property="BorderBrush" Value="{DynamicResource CyanBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="16,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PurchasedText}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding Note}" Margin="0,6,0,0" ToolTip="{Binding Note}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="4" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding PlanName, TargetNullValue=套餐未知}" Foreground="{DynamicResource AccentBrush}"/></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding SubscriptionText}" Foreground="{DynamicResource MutedBrush}"/></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding ResetCreditText}" Foreground="{DynamicResource AmberBrush}"/></Border>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasPrimaryUsage, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PrimaryDescription}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PrimaryRemaining, StringFormat=剩 {0:0}%}" Style="{StaticResource MutedText}"/>
                                </Grid>
                                <ProgressBar Maximum="100" Style="{StaticResource ModernProgressBar}" infra:AnimatedProgress.Value="{Binding PrimaryRemaining}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding PrimaryResetText}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,13,0,0" Visibility="{Binding HasSecondaryUsage, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SecondaryDescription}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SecondaryRemaining, StringFormat=剩 {0:0}%}" Style="{StaticResource MutedText}"/>
                                </Grid>
                                <ProgressBar Maximum="100" Style="{StaticResource ModernProgressBar}" Foreground="{DynamicResource CyanBrush}" infra:AnimatedProgress.Value="{Binding SecondaryRemaining}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SecondaryResetText}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="5" Margin="0,16,0,0">
                            <WrapPanel>
                                <Button Content="授权登录" Command="{Binding AuthorizeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,7"/>
                                <Button Content="查用量" Command="{Binding QueryUsageCommand}" Style="{StaticResource CardAction}"/>
                                <Button Content="编辑" Command="{Binding EditCommand}" Style="{StaticResource CardAction}"/>
                                <Button Content="切到 Codex" Command="{Binding SwitchCodexCommand}" Style="{StaticResource CardAction}"/>
                                <Button Content="兑换重置卡" Command="{Binding ConsumeResetCommand}" Style="{StaticResource CardAction}"/>
                                <Button Content="{Binding InvalidButtonText}" Command="{Binding ToggleInvalidCommand}" Style="{StaticResource CardAction}"/>
                                <Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,7"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" CornerRadius="8" Background="{DynamicResource InvalidWashBrush}"
                        IsHitTestVisible="False" Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVisibility}}"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="24" Visibility="{Binding IsAuthorizing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="5" Style="{StaticResource ModernProgressBar}"/>
                        <TextBlock Text="{Binding AuthorizationStatus}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,5"/>
                        <TextBlock Text="关闭浏览器后可重新打开；关闭此面板会立即取消授权。" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Content="重新打开" Command="{Binding ReopenAuthorizationCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="复制登录链接" Command="{Binding CopyAuthorizationUrlCommand}" Style="{StaticResource CardAction}"/>
                            <Button Content="复制邮箱" Command="{Binding CopyEmailCommand}" Style="{StaticResource CardAction}"/>
                            <Button Content="复制密码" Command="{Binding CopyPasswordCommand}" Style="{StaticResource CardAction}"/>
                            <Button Content="复制验证码" Command="{Binding CopyCodeCommand}" Style="{StaticResource CardAction}"/>
                            <Button Content="取消并关闭" Command="{Binding CancelAuthorizationCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <!-- 页面切换 -->
                    <RadioButton Content="账号列表" GroupName="Pages" Command="{Binding ShowAccountsPageCommand}"
                                 Style="{StaticResource PageTabButton}" AutomationProperties.Name="账号列表页">
                        <RadioButton.IsChecked>
                            <Binding Path="IsAccountsPage" Mode="OneWay"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton Content="添加账号" GroupName="Pages" Command="{Binding ShowAddAccountPageCommand}"
                                 Style="{StaticResource PageTabButton}" AutomationProperties.Name="添加账号页" Margin="6,0,10,0">
                        <RadioButton.IsChecked>
                            <Binding Path="IsAddAccountPage" Mode="OneWay"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,6,10,6"/>
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="导出与备份"
                            ToolTip="导出 JSON 备份和文本清单，并可打开导出目录">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,7,0"><Path Data="{StaticResource IconExport}" Fill="{DynamicResource TextBrush}"/></Viewbox><TextBlock Text="导出与备份"/></StackPanel>
                    </Button>
                    <Button Command="{Binding QueryAllCommand}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="一键查用量">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,7,0"><Path Data="{StaticResource IconBolt}" Fill="{DynamicResource GreenBrush}"/></Viewbox><TextBlock Text="一键查用量"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleKeepAliveCommand}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="切换保活">
                        <TextBlock Text="{Binding KeepAliveText}"/>
                    </Button>
                    <Button Command="{Binding RestartCodexCommand}" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="重启 Codex">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,7,0"><Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource CyanBrush}"/></Viewbox><TextBlock Text="重启 Codex"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="切换日间夜间模式" AutomationProperties.AutomationId="ThemeToggle">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,7,0"><Path Data="{StaticResource IconSun}" Fill="{DynamicResource AmberBrush}"/></Viewbox><TextBlock Text="{Binding ThemeLabel}"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Width="126" Height="38" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,10,0"
                            Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="{Binding GlobalTotpCountdown, StringFormat=验证码 {0} 刷新}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ProgressBar Maximum="30" Value="{Binding GlobalTotpRemaining}" Height="3" VerticalAlignment="Bottom" Margin="4" Style="{StaticResource ModernProgressBar}"/>
                        </Grid>
                    </Border>
                    <Grid Width="230" Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="36,8,10,8" ToolTip="搜索邮箱、备注或套餐"/>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Fill="{DynamicResource MutedBrush}"/></Viewbox>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 账号列表页 -->
        <AdornerDecorator Grid.Row="1" Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16"
                          AllowDrop="True" PreviewDragOver="Cards_PreviewDragOver" PreviewDrop="Cards_PreviewDrop"
                          PreviewDragLeave="Cards_PreviewDragLeave">
                <ItemsControl x:Name="AccountsItems" ItemsSource="{Binding AccountsView}" ItemTemplate="{StaticResource AccountCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <infra:ResponsiveGridPanel Breakpoint="1120" Gap="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </AdornerDecorator>

        <!-- 添加账号页 -->
        <views:AddAccountView Grid.Row="1" DataContext="{Binding AddAccountPage}"
                              Visibility="{Binding DataContext.IsAddAccountPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0"
                Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding OpenExportsFolderCommand}" Style="{StaticResource FlatFieldButton}"
                        VerticalAlignment="Center" Margin="12,0,14,0"
                        ToolTip="{Binding ExportsDirectory}"
                        AutomationProperties.Name="打开导出目录">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource IconFolder}" Fill="{DynamicResource MutedBrush}"/></Viewbox>
                        <TextBlock Text="{Binding ExportsDirectory}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MutedText}">
                    <Run Text="可见 "/><Run Text="{Binding VisibleAccountCount, Mode=OneWay}"/><Run Text=" · 无效 "/><Run Text="{Binding InvalidAccountCount, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,52"
                Style="{StaticResource ToastBorder}" Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ToastMessage}" FontWeight="SemiBold" MaxWidth="480" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="180" Height="6" IsIndeterminate="True" Style="{StaticResource ModernProgressBar}"/>
                <TextBlock Text="正在处理…" HorizontalAlignment="Center" Margin="0,13,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GptPlusManager.Core\GptPlusManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用图标：exe 图标 + 窗口标题栏 / 任务栏图标（窗口未显式设置 Icon 时
         继承 exe 图标，系统按显示尺寸挑 ICO 里最佳帧） -->
    <Resource Include="Assets\app.ico" />
    <None Include="Assets\app-icon.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.7.1</Version>
    <AssemblyName>ChatGptAccountManager</AssemblyName>
    <RootNamespace>GptPlusManager.Wpf</RootNamespace>
    <Product>ChatGPT Account Manager</Product>
    <AssemblyTitle>ChatGPT Account Manager</AssemblyTitle>
    <Description>Local-first ChatGPT / Codex multi-account manager</Description>
    <Company>chatgpt-account-manager</Company>
    <Copyright>MIT License</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

</Project>

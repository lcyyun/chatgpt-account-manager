<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Brushes live in the theme dictionary so swapping the dictionary
         replaces the brush instances themselves, which DynamicResource consumers pick up. -->
    <Color x:Key="CanvasColor">#0B0E14</Color>
    <Color x:Key="SurfaceColor">#121722</Color>
    <Color x:Key="SurfaceRaisedColor">#171D2A</Color>
    <Color x:Key="SurfaceHoverColor">#1B2332</Color>
    <Color x:Key="InputColor">#0E131D</Color>
    <Color x:Key="BorderColor">#273044</Color>
    <Color x:Key="BorderHoverColor">#52627F</Color>
    <Color x:Key="TextColor">#F3F6FC</Color>
    <Color x:Key="MutedColor">#99A5B9</Color>
    <Color x:Key="AccentColor">#7C6CF2</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="CyanColor">#36C4D8</Color>
    <Color x:Key="GreenColor">#3DDC97</Color>
    <Color x:Key="AmberColor">#F7B955</Color>
    <Color x:Key="DangerColor">#F06A78</Color>
    <Color x:Key="ProgressTrackColor">#252C3A</Color>
    <Color x:Key="ToggleTrackColor">#313A4A</Color>
    <Color x:Key="ToastColor">#EE202838</Color>
    <Color x:Key="CalendarOutsideColor">#667085</Color>
    <Color x:Key="InvalidWashColor">#1AF06A78</Color>
    <Color x:Key="ScrimColor">#66000000</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}" />
    <SolidColorBrush x:Key="ToggleTrackBrush" Color="{StaticResource ToggleTrackColor}" />
    <SolidColorBrush x:Key="ToastBrush" Color="{StaticResource ToastColor}" />
    <SolidColorBrush x:Key="CalendarOutsideBrush" Color="{StaticResource CalendarOutsideColor}" />
    <SolidColorBrush x:Key="InvalidWashBrush" Color="{StaticResource InvalidWashColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
</ResourceDictionary>

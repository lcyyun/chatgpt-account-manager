<UserControl x:Class="GptPlusManager.Wpf.ProviderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProviderListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模式切换 -->
        <Border Grid.Row="0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="路由模式" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="OfficialRadio" Content="官方模式" GroupName="Mode" Margin="0,0,22,0"
                                     Foreground="{DynamicResource TextBrush}" Checked="Mode_Checked"
                                     AutomationProperties.AutomationId="OfficialModeRadio"/>
                        <RadioButton x:Name="ThirdPartyRadio" Content="第三方模式" GroupName="Mode"
                                     Foreground="{DynamicResource TextBrush}" Checked="Mode_Checked"
                                     AutomationProperties.AutomationId="ThirdPartyModeRadio"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="ModeSummaryText" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="20,0,20,0"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ConfigPathText" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="380"/>
                    <TextBlock x:Name="KeyStatusSummary" Style="{StaticResource MutedText}" FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 供应商列表 + 详情 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="供应商" Style="{StaticResource SectionLabel}" Margin="12,11,12,7"/>
                    <ListBox x:Name="ProviderList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ProviderListBoxItem}"
                             SelectionChanged="ProviderList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,7,10,11">
                        <Button Content="新增" Width="66" Margin="0,0,6,0" Style="{StaticResource ModernButton}"
                                AutomationProperties.AutomationId="AddProviderButton" Click="AddProvider_Click"/>
                        <Button x:Name="DeleteProviderButton" Content="删除" Width="66" Style="{StaticResource DangerButton}"
                                AutomationProperties.AutomationId="DeleteProviderButton" Click="DeleteProvider_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <!-- 空状态：一个供应商都没有时右侧空白会让人以为界面坏了 -->
                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="还没有配置供应商" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="点左侧「新增」创建一个供应商，填入 Base URL、API Key 和模型列表，保存后即可切换到第三方模式。"/>
                    </StackPanel>

                    <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="供应商详情" Style="{StaticResource SectionLabel}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ID（写入 config.toml，仅字母数字与 - _）"
                                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ProviderIdBox" Style="{StaticResource ModernTextBox}"
                                             TextChanged="Detail_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="显示名称" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DisplayNameBox" Style="{StaticResource ModernTextBox}"
                                             TextChanged="Detail_Changed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Base URL（Responses API 根地址，例如 https://api.example.com/v1）"
                                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,4"/>
                            <TextBox x:Name="BaseUrlBox" Style="{StaticResource ModernTextBox}"
                                     TextChanged="Detail_Changed"/>

                            <TextBlock Text="API Key" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox" MinHeight="36" Padding="10,7"
                                             Background="{DynamicResource InputBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                             Foreground="{DynamicResource TextBrush}"
                                             PasswordChanged="ApiKey_PasswordChanged"/>
                                <Button x:Name="RevealKeyButton" Grid.Column="1" Content="显示" Width="60" Margin="6,0,0,0"
                                        Style="{StaticResource ModernButton}" Click="RevealKey_Click"/>
                            </Grid>
                            <TextBox x:Name="ApiKeyPlainBox" Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" TextChanged="ApiKeyPlain_TextChanged"/>
                            <TextBlock x:Name="KeyStatusText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>

                            <TextBlock Text="密钥注入方式" Style="{StaticResource MutedText}" FontSize="11" Margin="0,14,0,4"/>
                            <RadioButton x:Name="CommandAuthRadio" GroupName="Auth"
                                         Content="命令式（推荐：config.toml 里不含明文密钥，密钥 DPAPI 加密存储）"
                                         Foreground="{DynamicResource TextBrush}" Checked="AuthMode_Checked"/>
                            <RadioButton x:Name="PlainTokenAuthRadio" GroupName="Auth" Margin="0,6,0,0"
                                         Content="明文写入（保留官方账号上下文，但密钥以明文存于 config.toml）"
                                         Foreground="{DynamicResource TextBrush}" Checked="AuthMode_Checked"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="上下文窗口（token，留空按 128000）" Style="{StaticResource MutedText}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContextWindowBox" Style="{StaticResource ModernTextBox}"
                                             TextChanged="Detail_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="模型能力" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="SupportsImagesCheck" Content="支持图片输入"
                                              Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"
                                              Checked="Detail_Changed" Unchecked="Detail_Changed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="模型列表（每行一个，格式：模型ID 或 模型ID | 显示名）"
                                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,14,0,4"/>
                            <TextBox x:Name="ModelsBox" Style="{StaticResource ModernTextBox}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" Height="118"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     TextChanged="Detail_Changed"/>

                            <TextBlock Text="状态" Style="{StaticResource SectionLabel}" Margin="0,16,0,0"/>
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

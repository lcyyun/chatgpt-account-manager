<UserControl x:Class="GptPlusManager.Wpf.ProviderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProviderListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模式切换 -->
        <Border Grid.Row="0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="路由模式" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="OfficialRadio" Content="官方模式" GroupName="Mode" Margin="0,0,22,0"
                                     Foreground="{DynamicResource TextBrush}" Checked="Mode_Checked"
                                     AutomationProperties.AutomationId="OfficialModeRadio"/>
                        <RadioButton x:Name="ThirdPartyRadio" Content="第三方模式" GroupName="Mode"
                                     Foreground="{DynamicResource TextBrush}" Checked="Mode_Checked"
                                     AutomationProperties.AutomationId="ThirdPartyModeRadio"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="ModeSummaryText" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="20,0,20,0"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ConfigPathText" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="380"/>
                    <TextBlock x:Name="KeyStatusSummary" Style="{StaticResource MutedText}" FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 供应商列表 + 详情 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="供应商" Style="{StaticResource SectionLabel}" Margin="12,11,12,7"/>
                    <ListBox x:Name="ProviderList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ProviderListBoxItem}"
                             SelectionChanged="ProviderList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,7,10,11">
                        <Button Content="新增" Width="66" Margin="0,0,6,0" Style="{StaticResource ModernButton}"
                                AutomationProperties.AutomationId="AddProviderButton" Click="AddProvider_Click"/>
                        <Button x:Name="DeleteProviderButton" Content="删除" Width="66" Style="{StaticResource DangerButton}"
                                AutomationProperties.AutomationId="DeleteProviderButton" Click="DeleteProvider_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <!-- 空状态：一个供应商都没有时右侧空白会让人以为界面坏了 -->
                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="还没有配置供应商" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="点左侧「新增」创建一个供应商，填入 Base URL、API Key 和模型列表，保存后即可切换到第三方模式。"/>
                    </StackPanel>

                    <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="供应商详情" Style="{StaticResource SectionLabel}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ID（写入 config.toml，仅字母数字与 - _）"
                                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ProviderIdBox" Style="{StaticResource ModernTextBox}"
                                             TextChanged="Detail_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="显示名称" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DisplayNameBox" Style="{StaticResource ModernTextBox}"
                                             TextChanged="Detail_Changed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Base URL（Responses API 根地址，例如 https://api.example.com/v1）"
                                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,4"/>
                            <TextBox x:Name="BaseUrlBox" Style="{StaticResource ModernTextBox}"
                                     TextChanged="Detail_Changed"/>

                            <TextBlock Text="API Key" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,4"/>
                            <!-- 眼睛图标内嵌在输入框里，而不是外挂一个"显示"按钮：
                                 它只作用于这个字段，贴在字段里比另起一个按钮更直观。 -->
                            <Grid>
                                <PasswordBox x:Name="ApiKeyBox" MinHeight="36" Padding="10,7,40,7"
                                             Background="{DynamicResource InputBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                             Foreground="{DynamicResource TextBrush}"
                                             PasswordChanged="ApiKey_PasswordChanged"/>
                                <TextBox x:Name="ApiKeyPlainBox" MinHeight="36" Padding="10,7,40,7"
                                         Visibility="Collapsed"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="ApiKeyPlain_TextChanged"/>
                                <Button x:Name="RevealKeyButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="30" Height="30" Margin="0,0,4,0"
                                        Style="{StaticResource IconButton}"
                                        AutomationProperties.AutomationId="RevealKeyButton"
                                        AutomationProperties.Name="显示或隐藏密钥"
                                        ToolTip="显示 / 隐藏密钥" Click="RevealKey_Click">
                                    <Path x:Name="RevealKeyIcon" Data="{StaticResource IconEye}"
                                          Fill="{DynamicResource MutedBrush}" Stretch="Uniform" Width="15" Height="15"/>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="KeyStatusText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>

                            <TextBlock Text="密钥注入方式" Style="{StaticResource MutedText}" FontSize="11" Margin="0,14,0,4"/>
                            <RadioButton x:Name="CommandAuthRadio" GroupName="Auth"
                                         Content="命令式（推荐：config.toml 里不含明文密钥，密钥 DPAPI 加密存储）"
                                         Foreground="{DynamicResource TextBrush}" Checked="AuthMode_Checked"/>
                            <RadioButton x:Name="PlainTokenAuthRadio" GroupName="Auth" Margin="0,6,0,0"
                                         Content="明文写入（保留官方账号上下文，但密钥以明文存于 config.toml）"
                                         Foreground="{DynamicResource TextBrush}" Checked="AuthMode_Checked"/>

                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型列表" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="FetchModelsButton" Content="从端点获取"
                                        Style="{StaticResource ModernButton}" Padding="10,5" MinHeight="28" FontSize="12"
                                        Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="FetchModelsButton"
                                        ToolTip="查询 GET {Base URL}/models，用端点自己声明的写法填入列表"
                                        Click="FetchModels_Click"/>
                                <Button Grid.Column="2" x:Name="AddModelButton" Content="+ 添加模型"
                                        Style="{StaticResource ModernButton}" Padding="10,5" MinHeight="28" FontSize="12"
                                        AutomationProperties.AutomationId="AddModelButton"
                                        Click="AddModel_Click"/>
                            </Grid>

                            <!-- 每个模型一行：ID、窗口徽章、能力徽章、编辑/删除、启用开关 -->
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" MinHeight="44">
                                <ItemsControl x:Name="ModelList" Margin="2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" Margin="0,1" CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Slug}" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4"
                                                                Padding="6,2" Margin="8,0,0,0"
                                                                Visibility="{Binding HasWindow, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding WindowBadge}" FontSize="10"
                                                                       Foreground="{DynamicResource MutedBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4"
                                                                Padding="6,2" Margin="5,0,0,0"
                                                                Visibility="{Binding HasFlags, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding FlagBadge}" FontSize="10"
                                                                       Foreground="{DynamicResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                                                ToolTip="测试这个模型能否正常使用" Click="TestModel_Click"
                                                                AutomationProperties.Name="测试这个模型"
                                                                Tag="{Binding}">
                                                            <Path Data="{StaticResource IconBolt}" Fill="{DynamicResource GreenBrush}"
                                                                  Stretch="Uniform" Width="14" Height="14"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                                                Margin="2,0,0,0" ToolTip="编辑这个模型" Click="EditModel_Click"
                                                                AutomationProperties.Name="编辑模型"
                                                                Tag="{Binding}">
                                                            <Path Data="{StaticResource IconEdit}" Fill="{DynamicResource MutedBrush}"
                                                                  Stretch="Uniform" Width="14" Height="14"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                                                Margin="2,0,0,0" ToolTip="从列表移除" Click="RemoveModel_Click"
                                                                AutomationProperties.Name="移除模型"
                                                                Tag="{Binding}">
                                                            <Path Data="{StaticResource IconDelete}" Fill="{DynamicResource MutedBrush}"
                                                                  Stretch="Uniform" Width="14" Height="14"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                                              VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              AutomationProperties.AutomationId="ModelToggle"
                                                              ToolTip="关掉的模型不会写进 Codex 的模型目录"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock x:Name="ModelEmptyHint" Style="{StaticResource MutedText}" FontSize="11"
                                       Margin="2,6,0,0" Visibility="Collapsed"
                                       Text="还没有模型。点「从端点获取」拉取可用模型，或点「+ 添加模型」手动填写。"/>

                            <TextBlock Text="状态" Style="{StaticResource SectionLabel}" Margin="0,16,0,0"/>
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
